# 复制为 .env 并填入真实值;缺必填键后端起不来明报。

# ---- 服务 ----
APP_NAME=zhang-gui-zhi-ku
APP_ENV=development
LOG_LEVEL=INFO

# ---- Embedding (本机 GPU) ----
EMBED_MODEL=bge-m3
EMBED_DENSE_DIM=1024

# ---- Rerank (本机 GPU) ----
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- LLM (云端,必填 key) ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# ---- Milvus ----
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=kb_chunks

# ---- MongoDB ----
MONGO_URI=mongodb://mongo:27017
MONGO_DB=zhang_gui_zhi_ku

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kb-images
MINIO_SECURE=false

# ---- 检索超参 ----
ALPHA=0.7
RRF_K=60
TOP_K_RETRIEVE=20
TOP_N_RERANK=5

# ---- 分块超参 ----
MAX_TOKENS=512
MIN_TOKENS=64
